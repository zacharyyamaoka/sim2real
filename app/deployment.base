# sim2real app · one deployment: runs + coverage
# Written by tools/build_pages.py (do not edit by hand); data by tools/build_app.py. Grammar: vendor/data-ui
# (PEP 0004 dashboards, PEP 0005 cards). The host (app/app.js) fills {deployment} and {run}. REAL rack data; models are bam_rack_twin replays.
data: 'data/{deployment}/runs.json'
properties:
  title: { displayName: Run }
  started: { displayName: Started }
  device: { displayName: Station }
  status: { displayName: T2 }
  moves_x: { displayName: 'Moves ÷ floor (gate 1.5)' }
  hold_x: { displayName: 'Hold ÷ floor (gate 1.5)' }
  gate_x: { displayName: Gate }
  moves_before_x: { displayName: 'Moves, twin before / today' }
  hold_before_x: { displayName: 'Hold, twin before' }
  limiting_term: { displayName: Limiting term }
  evidence: { displayName: Evidence share }
  why: { displayName: Why (the study) }
  floor_growth_x: { displayName: Floor grew }
  overfit_pick: { displayName: Overfit pick }
  pick_rule: { displayName: Pick rule }
  round: { displayName: Round }
  worst_window: { displayName: Worst window }
  caveat: { displayName: Caveat }
  detail: { displayName: What it means }
  kind: { displayName: Kind }
  duration_s: { displayName: Duration }
  gains: { displayName: Gains (board) }
  compare: { displayName: Situations }
  tracking_mrad: { displayName: Real vs target }
  best_model: { displayName: Closest model }
  best_model_mrad: { displayName: Model vs real }
  verdict: { displayName: 'Twinned?' }
  page: { displayName: Open }
  day: { displayName: Day }
  session: { displayName: Session }
  rate_hz: { displayName: Rate }
style:
  chrome: minimal
  numbers: { digits: 3, compact: true }
  palette:
    real: var(--data-series-1)
    target: '#8b9099'
    twin D · LuGre: var(--data-series-2)
    twin G · LuGre re-fit: 'color-mix(in srgb, var(--data-series-2) 62%, black)'
    twin H · + dwell: 'color-mix(in srgb, var(--data-series-2) 55%, white)'
    twin R · rate-state: 'color-mix(in srgb, var(--data-series-2) 80%, black)'
    twin · full: var(--data-series-2)
    twin A · deployed: 'color-mix(in srgb, var(--data-series-2) 55%, white)'
    twin C · calibrated: var(--data-series-2)
    twin C1 · fast inertia: 'color-mix(in srgb, var(--data-series-2) 62%, black)'
    twin D · LuGre vs real: var(--data-series-2)
    twin G · LuGre re-fit vs real: 'color-mix(in srgb, var(--data-series-2) 62%, black)'
    twin H · + dwell vs real: 'color-mix(in srgb, var(--data-series-2) 55%, white)'
    twin R · rate-state vs real: 'color-mix(in srgb, var(--data-series-2) 80%, black)'
    twin · full vs real: var(--data-series-2)
    twin A · deployed vs real: 'color-mix(in srgb, var(--data-series-2) 55%, white)'
    twin C · calibrated vs real: var(--data-series-2)
    twin C1 · fast inertia vs real: 'color-mix(in srgb, var(--data-series-2) 62%, black)'
    real vs target: var(--data-series-1)
datasets:
  runs:
    data: 'data/{deployment}/runs.json'
    label: Runs
    facets:
      - { property: device, label: Station }
      - { property: kind, label: Kind }
      - { property: day, label: Day }
      - { property: compare, label: Situations }
      - { property: duration_s, as: range, label: Duration }
  coverage:
    data: 'data/{deployment}/coverage.json'
    label: Coverage station
    facets: [{ property: device, as: select, label: Coverage station }]
    filters: 'device == "CAN 12"'
  coverage_all: { data: 'data/{deployment}/coverage.json', label: 'Coverage, every station' }
  devices: { data: 'data/{deployment}/devices.json', label: Stations }
  why: { data: 'data/{deployment}/why.json', label: Why it fails }
  caveats: { data: 'data/{deployment}/caveats.json', label: Caveats }
links:
  - { from: coverage_all.run, to: runs.run }
  - { from: devices.device, to: runs.device }
layout:
  panels:
    - text: "## One Dof Test Rack · runs\n**REAL data**, Oct 23-28: every run the rack recorded, newest first. The rail narrows the runs; click rows to overlay just those runs in *Angle over time* and the station boxes, or **Open ↗** to play one back against its models. Blue is real, orange is a model, grey dashed is the target."
      w: 12
    - { view: Runs shown, w: 3, h: 2 }
    - { view: Hours shown, w: 3, h: 2 }
    - { view: Stations shown, w: 3, h: 2 }
    - { view: Runs with models, w: 3, h: 2 }
    - text: "### Why it fails\nOne row per station from the calibration round and its 10-29 follow-ups (bam_rack_twin calibration_why_2.json): T2 on the held-out tapes, moves and hold offset each against **1.5× the floor** (after the round, with the twin before it beside it), the limiting term in the study's words, and how much of the held-out torque gap that term's family explains on its own. **Click a row** to play its worst held-out window. Read it with the caveats below it: they change how good the ratios look, and one is a decision still open."
      w: 12
    - { view: Why it fails, w: 12, h: 4 }
    - { view: Caveats, w: 12, h: 5, toolbar: none }
    - { view: Runs, w: 12, h: 5, title: Runs · newest first, toolbar: compact }
    - text: "### Coverage\nWhere the runs went. Every path is drawn faint (10 %), so the dark bands are where the rack spends its time; the dashed box is each station's proven window (bam_rack_twin TAPE_STATIONS: travel × speed ceiling; stations with no recorded window have none). Counts are grid samples, so ÷ the grid rate is seconds. The station panels follow **Coverage station** on the rail (CAN 12 first)."
      w: 12
    - { view: Phase space · every run, w: 7, h: 5 }
    - { view: 'Time at (q, qd)', w: 5, h: 5 }
    - { view: Angle histogram, w: 4, h: 3 }
    - { view: Speed histogram, w: 4, h: 3 }
    - { view: Acceleration histogram, w: 4, h: 3 }
    - text: "### Every station side by side\nMin-max whiskers, so the extremes are exact (each run's argmin/argmax rows are kept)."
      w: 12
    - { view: Angle by station, w: 4, h: 3 }
    - { view: Speed by station, w: 4, h: 3 }
    - { view: Acceleration by station, w: 4, h: 3 }
    - { view: Angle over time · every run, w: 12, h: 4 }
views:
  - type: kpi
    name: Runs shown
    from: runs
    kpi:
      label: Runs
      value: { property: run, summary: Count }
  - type: kpi
    name: Hours shown
    from: runs
    kpi:
      label: Seconds of real data
      value: { property: duration_s, summary: Sum }
  - type: kpi
    name: Stations shown
    from: runs
    kpi:
      label: Stations
      value: { property: device, summary: Unique }
  - type: kpi
    name: Runs with models
    from: runs
    filters: 'models > 0'
    kpi:
      label: Runs replayed by a model
      value: { property: run, summary: Count }
  - type: table
    name: Why it fails
    from: why
    open: { mode: link, url: page }
    order: [device, status, moves_x, hold_x, moves_before_x, floor_growth_x, overfit_pick, pick_rule, limiting_term, evidence, why, worst_window, hold_before_x, round]
  - type: table
    name: Caveats
    from: caveats
    order: [caveat, detail]
    rowHeight: extra
    columnSize: { caveat: 200, detail: 900 }
  - type: table
    name: Runs
    from: runs
    select: run
    order: [title, started, device, kind, duration_s, gains, compare, tracking_mrad, best_model, best_model_mrad, page]
    sort:
      - { property: started, direction: DESC }
  - type: chart
    name: Phase space · every run
    from: coverage
    chart:
      mark: { type: line, strokeWidth: 1, interpolate: linear }
      encoding:
        x: { field: q_deg, type: quantitative, title: 'q (°)' }
        'y': { field: qd_deg_s, type: quantitative, title: 'qd (°/s)' }
        detail: { field: run, type: nominal }
        order: { field: t, type: quantitative }
        color:
          field: layer
          type: nominal
          title: null
          scale:
            domain: [path, workspace]
            range: ['color-mix(in srgb, var(--data-series-1) 10%, transparent)', '#8b9099']
  - type: chart
    name: 'Time at (q, qd)'
    from: coverage
    chart:
      transform: [{ filter: 'datum.w == 1' }]
      mark: rect
      encoding:
        x: { field: q_deg, type: quantitative, bin: { maxbins: 60 }, title: 'q (°)' }
        'y': { field: qd_deg_s, type: quantitative, bin: { maxbins: 40 }, title: 'qd (°/s)' }
        color:
          field: w
          aggregate: sum
          type: quantitative
          title: samples
          scale: { scheme: blues, type: log }
  - type: chart
    name: Angle by station
    from: coverage_all
    filters: 'layer == "path"'
    chart:
      mark: { type: boxplot, extent: min-max }
      encoding:
        color: { value: var(--data-series-1) }
        x:
          field: device
          type: nominal
          title: null
          sort:
            - CAN 1
            - CAN 4
            - CAN 11
            - CAN 12
            - CAN 13
            - CAN 14
            - CAN 15
            - CAN 21
        'y': { field: q_deg, type: quantitative, title: 'q (°)' }
  - type: chart
    name: Speed by station
    from: coverage_all
    filters: 'layer == "path"'
    chart:
      mark: { type: boxplot, extent: min-max }
      encoding:
        color: { value: var(--data-series-1) }
        x:
          field: device
          type: nominal
          title: null
          sort:
            - CAN 1
            - CAN 4
            - CAN 11
            - CAN 12
            - CAN 13
            - CAN 14
            - CAN 15
            - CAN 21
        'y': { field: qd_deg_s, type: quantitative, title: 'qd (°/s)' }
  - type: chart
    name: Acceleration by station
    from: coverage_all
    filters: 'layer == "path"'
    chart:
      mark: { type: boxplot, extent: min-max }
      encoding:
        color: { value: var(--data-series-1) }
        x:
          field: device
          type: nominal
          title: null
          sort:
            - CAN 1
            - CAN 4
            - CAN 11
            - CAN 12
            - CAN 13
            - CAN 14
            - CAN 15
            - CAN 21
        'y': { field: qdd_deg_s2, type: quantitative, title: 'qdd (°/s², derived)' }
  - type: chart
    name: Angle histogram
    from: coverage
    chart:
      mark: { type: bar }
      encoding:
        color: { value: var(--data-series-1) }
        x: { field: q_deg, type: quantitative, bin: { maxbins: 40 }, title: 'q (°)' }
        'y': { field: w, aggregate: sum, type: quantitative, title: 'samples (÷ grid Hz = s)' }
  - type: chart
    name: Speed histogram
    from: coverage
    chart:
      mark: { type: bar }
      encoding:
        color: { value: var(--data-series-1) }
        x: { field: qd_deg_s, type: quantitative, bin: { maxbins: 40 }, title: 'qd (°/s)' }
        'y': { field: w, aggregate: sum, type: quantitative, title: 'samples (÷ grid Hz = s)' }
  - type: chart
    name: Acceleration histogram
    from: coverage
    chart:
      mark: { type: bar }
      encoding:
        color: { value: var(--data-series-1) }
        x: { field: qdd_deg_s2, type: quantitative, bin: { maxbins: 40 }, title: 'qdd (°/s², derived)' }
        'y': { field: w, aggregate: sum, type: quantitative, title: 'samples (÷ grid Hz = s)' }
  - type: chart
    name: Angle over time · every run
    from: coverage_all
    filters: 'layer == "path"'
    chart:
      mark: { type: line, strokeWidth: 1 }
      encoding:
        color: { value: 'color-mix(in srgb, var(--data-series-1) 10%, transparent)' }
        x: { field: t, type: quantitative, title: t from run start (s) }
        'y': { field: q_deg, type: quantitative, title: 'q (°)' }
        detail: { field: run, type: nominal }
