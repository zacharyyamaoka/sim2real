    "path": "/home/bam/.cache/like_keras/mujoco_menagerie/universal_robots_ur5e/ur5e.xml",
    "source": "MuJoCo Menagerie universal_robots_ur5e + robotiq_2f85 @ 71f066a",
    "attach": [
      {
        "site": "attachment_site",
        "path": "/home/bam/.cache/like_keras/mujoco_menagerie/robotiq_2f85/2f85.xml",
