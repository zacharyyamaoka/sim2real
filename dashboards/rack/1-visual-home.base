# sim2real · proposal 1-visual-home · scale rack: Space: the robot in 3D and its cameras, every view sim vs real, a badge per device
# Built by dashboards/build.py (2026-10-28); data-ui grammar: vendor/data-ui (PEP 0004 dashboards, PEP 0005 cards).
# REAL rack data.
data: devices.json
properties:
  device: { displayName: Device }
  type: { displayName: Type }
  verdict: { displayName: Verdict }
  ratio: { displayName: 'Twin ÷ floor' }
  gate_used: { displayName: Gate used }
  gate_limit: { displayName: limit }
  sim_vs_real: { displayName: Sim vs real }
  floor: { displayName: Floor }
  real_vs_target: { displayName: Real vs target }
  torque_ratio: { displayName: 'Torque ÷ floor' }
  situation: { displayName: Situation }
  q_deg: { displayName: Angle }
  gap_mrad: { displayName: 'Twin − real' }
  tau_nm: { displayName: Torque }
  gate_title: { displayName: Gate }
  status: { displayName: Status }
  allocation_mm: { displayName: Allocation }
  sim_vs_real_mm: { displayName: Sim vs real (tool mm) }
  real_vs_target_mm: { displayName: Real vs target (tool mm) }
  used: { displayName: Used }
  label: { displayName: Node }
style:
  chrome: minimal
  numbers: { digits: 3, compact: true }
  palette:
    target: '#8b9099'
    real: '#2a78d6'
    twin: '#e8743b'
    real B: '#8fb8ea'
    twin ×20: '#e8743b'
    floor: '#9aa0a6'
    'floor −': '#9aa0a6'
clock: { data: scene, time: t, loop: true }
datasets: { devices: devices.json, scene: scene.json, servo: samples_servo.json, media: media.json }
links: [{ from: servo.run_set, to: scene.run_set }]
layout:
  panels:
    - text: "## Visual home · 1-DOF rack\n**Scale: 1-DOF · One Dof Test Rack · REAL data.** 8 motors, real held-out runs (Oct 23-25) against each station's twin (bam_rack_twin, replayed; RMS reproduced exactly). One real camera (CAN 14's RealSense); no sim render of the rack exists, so no camera can be wiped yet. Green = twin within 1.5× the device's own run-to-run floor. The 3D draws the twin as a ghost with its error ×20. Click a device's badge to open its type's standard block (Type catalog) with that device selected."
      w: 12
    - { view: Twinned, w: 3, h: 3 }
    - view: 'Calibrated?'
      w: 9
      h: 3
      title: "Calibrated? Each device's share of its fidelity gate (≤ 1 passes)"
    - { view: Playback, w: 12 }
    - { view: '3D · real (solid) vs twin (ghost, error ×20)', w: 7, h: 5 }
    - { view: 'Camera · CAN 14, real still (no sim render)', w: 5, h: 5 }
    - { view: 'Joint gap · twin − real, every servo', w: 12, h: 3 }
views:
  - type: gauge
    name: Twinned
    from: devices
    gauge:
      value: { property: twinned, summary: Sum }
      min: 0
      max: 9
      target: 9
      shape: arc
      better: higher
      label: 'Devices twinned (≤ 1.5× their floor)'
      bands:
        - { to: 4.5, tone: bad }
        - { to: 8.5, tone: warn }
        - { tone: good }
  - type: kpi
    name: 'Calibrated?'
    from: devices
    groupBy: { property: device }
    kpi:
      value: { property: gate_used }
      compare: { against: gate_limit, better: lower }
  - type: playback
    name: Playback
    playback: { speeds: [0.25, 0.5, 1, 2], range: true, readout: true }
  - type: scene3d
    name: '3D · real (solid) vs twin (ghost, error ×20)'
    from: scene
    scene3d:
      x: px
      'y': py
      z: pz
      series: situation
      target: twin ×20
      t: t
      skeleton:
        - [m0_bx, m0_by, m0_bz]
        - [m0_ax, m0_ay, m0_az]
        - [m0_tx, m0_ty, m0_tz]
        - [gap_x, gap_y, gap_z]
        - [m1_bx, m1_by, m1_bz]
        - [m1_ax, m1_ay, m1_az]
        - [m1_tx, m1_ty, m1_tz]
        - [gap_x, gap_y, gap_z]
        - [m2_bx, m2_by, m2_bz]
        - [m2_ax, m2_ay, m2_az]
        - [m2_tx, m2_ty, m2_tz]
        - [gap_x, gap_y, gap_z]
        - [m3_bx, m3_by, m3_bz]
        - [m3_ax, m3_ay, m3_az]
        - [m3_tx, m3_ty, m3_tz]
        - [gap_x, gap_y, gap_z]
        - [m4_bx, m4_by, m4_bz]
        - [m4_ax, m4_ay, m4_az]
        - [m4_tx, m4_ty, m4_tz]
        - [gap_x, gap_y, gap_z]
        - [m5_bx, m5_by, m5_bz]
        - [m5_ax, m5_ay, m5_az]
        - [m5_tx, m5_ty, m5_tz]
        - [gap_x, gap_y, gap_z]
        - [m6_bx, m6_by, m6_bz]
        - [m6_ax, m6_ay, m6_az]
        - [m6_tx, m6_ty, m6_tz]
        - [gap_x, gap_y, gap_z]
        - [m7_bx, m7_by, m7_bz]
        - [m7_ax, m7_ay, m7_az]
        - [m7_tx, m7_ty, m7_tz]
  - type: image
    name: 'Camera · CAN 14, real still (no sim render)'
    from: media
    image: poster
    caption: [caption]
  - type: timeseries
    name: 'Joint gap · twin − real, every servo'
    from: servo
    timeseries: { x: t, 'y': gap_mrad, series: device, unit: mrad, legend: top }
    filters: 'situation == "twin" && run_set == "8 motors · held-out waypoints"'
