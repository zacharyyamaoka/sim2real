# sim2real · proposal 3-gate-matrix · scale rack: Acceptance: devices x gates, each cell a pass/fail you can open
# Built by dashboards/build.py (2026-10-28); data-ui grammar: vendor/data-ui (PEP 0004 dashboards, PEP 0005 cards).
# REAL rack data.
data: gates.json
properties:
  device: { displayName: Device }
  type: { displayName: Type }
  verdict: { displayName: Verdict }
  ratio: { displayName: 'Twin ÷ floor' }
  gate_used: { displayName: Gate used }
  gate_limit: { displayName: limit }
  sim_vs_real: { displayName: Sim vs real }
  floor: { displayName: Floor }
  real_vs_target: { displayName: Real vs target }
  torque_ratio: { displayName: 'Torque ÷ floor' }
  situation: { displayName: Situation }
  q_deg: { displayName: Angle }
  gap_mrad: { displayName: 'Twin − real' }
  tau_nm: { displayName: Torque }
  gate_title: { displayName: Gate }
  status: { displayName: Status }
  allocation_mm: { displayName: Allocation }
  sim_vs_real_mm: { displayName: Sim vs real (tool mm) }
  real_vs_target_mm: { displayName: Real vs target (tool mm) }
  used: { displayName: Used }
  label: { displayName: Node }
style:
  chrome: minimal
  numbers: { digits: 3, compact: true }
  palette:
    target: '#8b9099'
    real: '#2a78d6'
    twin: '#e8743b'
    real B: '#8fb8ea'
    twin ×20: '#e8743b'
    floor: '#9aa0a6'
    'floor −': '#9aa0a6'
datasets: { gates: { data: gates.json, facets: [type, status] }, devices: devices.json }
links: [{ from: gates.device, to: devices.device }]
layout:
  panels:
    - text: "## Gate matrix · 1-DOF rack\n**Scale: 1-DOF · One Dof Test Rack · REAL data.** 8 motors, real held-out runs (Oct 23-25) against each station's twin (bam_rack_twin, replayed; RMS reproduced exactly). One real camera (CAN 14's RealSense); no sim render of the rack exists, so no camera can be wiped yet. Rows are devices, blocks are gates in order; hover a block for its value, click it for the evidence."
      w: 12
    - { view: Gate cells passing, w: 3, h: 2 }
    - { view: Devices twinned, w: 3, h: 2 }
    - { view: Passing per gate, w: 6, h: 2 }
    - text: '**Blocks, left to right:** T1 floor · T2 fidelity · T3 torque · T4 static accuracy · T5 encoder-blind terms · T6 drive gain · T7 envelope · T8 thermal · T9 warm and cold · T10 live re-identification · T11 provenance · (other device types: their own gates, in order)'
      w: 12
    - { view: Devices × gates, w: 12, h: 4 }
    - { view: Evidence, w: 12, h: 5, toolbar: full }
views:
  - type: gauge
    name: Gate cells passing
    from: gates
    gauge:
      value: { property: passed, summary: Ratio, per: cell }
      min: 0
      max: 1
      target: 1
      shape: arc
      better: higher
      label: 'Cells passing, of 89'
      bands:
        - { to: 0.5, tone: bad }
        - { to: 0.99, tone: warn }
        - { tone: good }
  - type: gauge
    name: Devices twinned
    from: devices
    gauge:
      value: { property: twinned, summary: Sum }
      min: 0
      max: 9
      target: 9
      shape: arc
      better: higher
      label: 'Devices twinned (≤ 1.5× their floor)'
      bands:
        - { to: 4.5, tone: bad }
        - { to: 8.5, tone: warn }
        - { tone: good }
  - type: barlist
    name: Passing per gate
    from: gates
    barlist: { label: gate_title, value: { property: passed, summary: Sum }, better: higher, limit: 12 }
  - type: tracker
    name: Devices × gates
    from: gates
    groupBy: { property: device }
    groupOrder: [CAN 14, CAN 15, CAN 1, CAN 4, CAN 21, CAN 11, CAN 12, CAN 13, RealSense 218622274411]
    sort:
      - { property: order, direction: ASC }
    tracker:
      state: status
      label: gate_title
      tones: { pass: good, fail: bad, partial: warn, not_run: muted }
  - type: table
    name: Evidence
    from: gates
    groupBy: { property: gate_title }
    order: [device, status, value, target, detail, evidence, basis]
